// sesion.js - Gestión de estados de sesión y perfil de usuario
(function() {
    'use strict';

    const SESSION_KEY = 'sessionUser';
    const PROFILE_DROPDOWN_ID = 'profile-dropdown';

    function getSession() {
        try {
            const sessionData = localStorage.getItem(SESSION_KEY);
            return sessionData ? JSON.parse(sessionData) : null;
        } catch (e) {
            console.warn('Error al leer sesión:', e);
            return null;
        }
    }

    function clearSession() {
        localStorage.removeItem(SESSION_KEY);
    }

    function updateUI() {
        const dropdown = document.getElementById(PROFILE_DROPDOWN_ID);
        if (!dropdown) return;

        const session = getSession();

        if (session) {
            dropdown.innerHTML = `
                <a href="#" class="icon-link" id="profile-trigger">
                    <i class="fas fa-user-circle"></i> ${session.nombre || session.email.split('@')[0]}
                </a>
                <div class="profile-dropdown-menu" id="profile-menu">
                    <a href="#" id="editar-datos"><i class="fas fa-user-edit"></i> Editar Datos</a>
                    <a href="#" id="cerrar-sesion"><i class="fas fa-sign-out-alt"></i> Cerrar Sesión</a>
                </div>
            `;
            attachDropdownEvents();
        } else {
            dropdown.innerHTML = `
                <a href="login.html" class="icon-link">
                    <i class="fas fa-sign-in-alt"></i> Login
                </a>
            `;
        }
    }

    function attachDropdownEvents() {
        const trigger = document.getElementById('profile-trigger');
        const menu = document.getElementById('profile-menu');
        const dropdown = document.getElementById(PROFILE_DROPDOWN_ID);
        const editarBtn = document.getElementById('editar-datos');
        const cerrarBtn = document.getElementById('cerrar-sesion');

        if (!trigger || !menu) return;

        // Toggle dropdown on click
        trigger.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            dropdown.classList.toggle('active');
            menu.classList.toggle('show');
        });

        // Close dropdown when clicking outside
        document.addEventListener('click', function(e) {
            if (!dropdown.contains(e.target)) {
                dropdown.classList.remove('active');
                menu.classList.remove('show');
            }
        });

        // Touch support - tap outside to close
        document.addEventListener('touchstart', function(e) {
            if (!dropdown.contains(e.target)) {
                dropdown.classList.remove('active');
                menu.classList.remove('show');
            }
        });

        // Editar Datos
        if (editarBtn) {
            editarBtn.addEventListener('click', function(e) {
                e.preventDefault();
                // Por ahora redirige a login para editar (puede crearse perfil.html)
                alert('Función de edición de datos en desarrollo. Por favor contacta al administrador.');
                dropdown.classList.remove('active');
                menu.classList.remove('show');
            });
        }

        // Cerrar Sesión
        if (cerrarBtn) {
            cerrarBtn.addEventListener('click', function(e) {
                e.preventDefault();
                clearSession();
                window.location.href = 'index.html';
            });
        }
    }

    // Función global para verificar sesión (usada por carrito.js)
    window.verificarSesionCheckout = function() {
        const session = getSession();
        if (!session) {
            const next = encodeURIComponent('pago.html');
            window.location.href = `login.html?next=${next}`;
            return false;
        }
        return true;
    };

    // Inicializar al cargar el DOM
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', updateUI);
    } else {
        updateUI();
    }

    // Escuchar cambios de sesión en otras pestañas
    window.addEventListener('storage', function(e) {
        if (e.key === SESSION_KEY) {
            updateUI();
        }
    });

})();
