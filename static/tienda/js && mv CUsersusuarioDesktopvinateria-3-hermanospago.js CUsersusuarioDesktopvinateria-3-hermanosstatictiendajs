// admi.js - Administración: CRUD de Productos y Clientes usando localStorage

(function(){
    // Utilities
    const storage = {
        getProducts(){
            return JSON.parse(localStorage.getItem('products')||'[]').filter(p=>!p.deleted);
        },
        saveProducts(products){
            localStorage.setItem('products', JSON.stringify(products));
        },
        getAllProductsRaw(){
            return JSON.parse(localStorage.getItem('products')||'[]');
        },
        getClients(){
            return JSON.parse(localStorage.getItem('clients')||'[]').filter(c=>!c.deleted);
        },
        saveClients(clients){
            localStorage.setItem('clients', JSON.stringify(clients));
        }
    };

    // Image helper: file -> base64
    function fileToBase64(file) {
        return new Promise((resolve,reject)=>{
            const reader = new FileReader();
            reader.onload = ()=> resolve(reader.result);
            reader.onerror = reject;
            reader.readAsDataURL(file);
        });
    }

    // Inventory rendering
    function renderInventory(){
        const tbody = document.getElementById('inventory-tbody');
        if(!tbody) return;
        const products = storage.getProducts();
        tbody.innerHTML = '';
        products.forEach(prod=>{
            const tr = document.createElement('tr');
            tr.dataset.id = prod.id;
            tr.innerHTML = `
                <td>${prod.id}</td>
                <td>${prod.name}</td>
                <td>${prod.category}</td>
                <td class="stock">${prod.stock}</td>
                <td>${prod.price}</td>
                <td class="status-in">${prod.stock>0? 'En Stock':'Agotado'}</td>
                <td>
                    <button class="btn-action btn-edit" data-id="${prod.id}"><i class="fas fa-edit"></i></button>
                    <button class="btn-action btn-delete" data-id="${prod.id}"><i class="fas fa-trash-alt"></i></button>
                </td>
            `;
            tbody.appendChild(tr);
        });

        // attach handlers
        tbody.querySelectorAll('.btn-edit').forEach(btn=>btn.addEventListener('click', onEditProduct));
        tbody.querySelectorAll('.btn-delete').forEach(btn=>btn.addEventListener('click', onDeleteProduct));
    }

    async function openProductForm(mode='create', product){
        // modal container
        let modal = document.getElementById('product-modal');
        if(!modal){
            modal = document.createElement('div');
            modal.id = 'product-modal';
            modal.className = 'modal';
            modal.innerHTML = `
                <div class="modal-content">
                    <h3 id="modal-title">Producto</h3>
                    <label>ID (automático si vacío)</label>
                    <input id="p-id" placeholder="ID Producto">
                    <label>Nombre</label>
                    <input id="p-name" placeholder="Nombre del producto">
                    <label>Categoría</label>
                    <input id="p-category" placeholder="Categoría">
                    <label>Stock</label>
                    <input id="p-stock" type="number" min="0" value="0">
                    <label>Precio</label>
                    <input id="p-price" placeholder="Precio">
                    <label>Imagen</label>
                    <input id="p-image" type="file" accept="image/*">
                    <div style="margin-top:10px; text-align:right;">
                        <button id="btn-cancel-product">Cancelar</button>
                        <button id="btn-save-product">Guardar</button>
                    </div>
                </div>
            `;
            document.body.appendChild(modal);
            document.getElementById('btn-cancel-product').addEventListener('click', ()=> modal.remove());
        }

        document.getElementById('modal-title').textContent = mode==='create'?'Agregar Producto':'Editar Producto';
        document.getElementById('p-id').value = product?.id||'';
        document.getElementById('p-name').value = product?.name||'';
        document.getElementById('p-category').value = product?.category||'';
        document.getElementById('p-stock').value = product?.stock||0;
        document.getElementById('p-price').value = product?.price||'';
        document.getElementById('p-image').value = '';

        document.getElementById('btn-save-product').onclick = async ()=>{
            const idInput = document.getElementById('p-id').value.trim();
            const name = document.getElementById('p-name').value.trim();
            const category = document.getElementById('p-category').value.trim();
            const stock = parseInt(document.getElementById('p-stock').value,10)||0;
            const price = document.getElementById('p-price').value.trim();
            const imageFile = document.getElementById('p-image').files[0];

            if(!name){
                Swal.fire('Error','El nombre es requerido','error');
                return;
            }

            const productsRaw = storage.getAllProductsRaw();
            let id = idInput||('PRD'+Date.now());
            const existingIndex = productsRaw.findIndex(p=>p.id===id);
            let imageData = product?.image||'';
            if(imageFile){
                try{ imageData = await fileToBase64(imageFile); }catch(e){console.error(e);} 
            }

            const newProd = { id, name, category, stock, price, image: imageData, deleted:false };
            if(existingIndex>=0){
                productsRaw[existingIndex] = { ...productsRaw[existingIndex], ...newProd };
            } else {
                productsRaw.push(newProd);
            }
            storage.saveProducts(productsRaw);
            Swal.fire('Guardado','Producto guardado correctamente','success');
            document.getElementById('product-modal').remove();
            renderInventory();
        };
    }

    function onEditProduct(e){
        const id = e.currentTarget.dataset.id;
        const products = storage.getAllProductsRaw();
        const prod = products.find(p=>p.id===id);
        openProductForm('edit', prod);
    }

    function onDeleteProduct(e){
        const id = e.currentTarget.dataset.id;
        Swal.fire({
            title: '¿Eliminar producto?',
            text: 'Se realizará un borrado lógico. ¿Desea continuar? ',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Sí, eliminar',
            cancelButtonText: 'Cancelar'
        }).then(result=>{
            if(result.isConfirmed){
                const productsRaw = storage.getAllProductsRaw();
                const idx = productsRaw.findIndex(p=>p.id===id);
                if(idx>=0){ productsRaw[idx].deleted = true; storage.saveProducts(productsRaw); renderInventory(); Swal.fire('Eliminado','Producto eliminado (lógico)','success'); }
            }
        });
    }

    // Clients management
    function renderClients(){
        const tbody = document.getElementById('clients-tbody');
        if(!tbody) return;
        const clients = storage.getClients();
        tbody.innerHTML = '';
        clients.forEach((c, i)=>{
            const tr = document.createElement('tr');
            tr.innerHTML = `<td>${c.name}</td><td>${c.email}</td><td><button class="edit-client" data-index="${i}">Editar</button> <button class="delete-client" data-index="${i}">Eliminar</button></td>`;
            tbody.appendChild(tr);
        });
        tbody.querySelectorAll('.edit-client').forEach(b=>b.addEventListener('click', onEditClient));
        tbody.querySelectorAll('.delete-client').forEach(b=>b.addEventListener('click', onDeleteClient));
    }

    function onEditClient(e){
        const idx = parseInt(e.currentTarget.dataset.index,10);
        const clients = JSON.parse(localStorage.getItem('clients')||'[]');
        const client = clients.filter(c=>!c.deleted)[idx];
        if(!client) return;
        document.getElementById('client-name').value = client.name;
        document.getElementById('client-email').value = client.email;
        document.getElementById('btn-save-client').dataset.editIndex = idx;
    }

    function onDeleteClient(e){
        const idx = parseInt(e.currentTarget.dataset.index,10);
        Swal.fire({title:'Eliminar cliente?', icon:'warning', showCancelButton:true}).then(res=>{
            if(res.isConfirmed){
                const clients = JSON.parse(localStorage.getItem('clients')||'[]');
                // mark logical delete for the corresponding not-deleted client at position idx
                let visibleCount = -1; let target = -1;
                for(let i=0;i<clients.length;i++){
                    if(!clients[i].deleted) visibleCount++;
                    if(visibleCount===idx){ target=i; break; }
                }
                if(target>=0){ clients[target].deleted = true; localStorage.setItem('clients', JSON.stringify(clients)); renderClients(); Swal.fire('Eliminado','Cliente eliminado (lógico)','success'); }
            }
        });
    }

    function saveClient(){
        const name = document.getElementById('client-name').value.trim();
        const email = document.getElementById('client-email').value.trim();
        if(!name||!email){ Swal.fire('Error','Nombre y correo son requeridos','error'); return; }
        const clients = JSON.parse(localStorage.getItem('clients')||'[]');
        const editIndexAttr = document.getElementById('btn-save-client').dataset.editIndex;
        if(editIndexAttr){
            // find actual index for that visible position
            const visiblePos = parseInt(editIndexAttr,10);
            let visibleCount=-1, target=-1;
            for(let i=0;i<clients.length;i++){
                if(!clients[i].deleted) visibleCount++;
                if(visibleCount===visiblePos){ target=i; break; }
            }
            if(target>=0){ clients[target] = { ...clients[target], name, email }; }
            delete document.getElementById('btn-save-client').dataset.editIndex;
        } else {
            clients.push({ name, email, deleted:false, id: 'CLT'+Date.now() });
        }
        localStorage.setItem('clients', JSON.stringify(clients));
        document.getElementById('client-name').value=''; document.getElementById('client-email').value='';
        renderClients();
        Swal.fire('Guardado','Cliente guardado correctamente','success');
    }

    // Initialization
    function init(){
        // inventory page
        if(document.getElementById('inventory-tbody')){
            renderInventory();
            const btn = document.getElementById('btn-nuevo-producto');
            if(btn) btn.addEventListener('click', ()=> openProductForm('create'));
        }
        // clients page / admi.html
        if(document.getElementById('clients-tbody')){
            renderClients();
            document.getElementById('btn-save-client').addEventListener('click', saveClient);
        }
    }

    document.addEventListener('DOMContentLoaded', init);

})();
